# API Configuration
# Set to "true" for standalone demo (no backend). Set to "false" or remove for real deployment.
VITE_USE_DEMO=false

# Backend API URL. Used when VITE_USE_DEMO=false.
# For local dev with Laravel: leave empty (uses vite proxy to localhost:8000)
# For production: https://api.orood.sa
VITE_API_URL=

# Optional: shown on Dashboard > Help as the support mailto address
# VITE_SUPPORT_EMAIL=support@yourdomain.com

# Maps — full checklist: frontend/docs/MAPS_SETUP.md
# Google Cloud: enable Maps JavaScript API, Places API, Geocoding API; restrict key by HTTP referrer + API.
# Budgets/alerts and daily quotas are strongly recommended before production.
#
# VITE_MAP_PROVIDER=          # unset = auto (Google if key set, else OSM); google | osm
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_MAP_DEFAULT_LAT=24.7136
# VITE_MAP_DEFAULT_LNG=46.6753
