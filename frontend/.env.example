# API Configuration
# Set to "true" for standalone demo (no backend). Set to "false" or remove for real deployment.
VITE_USE_DEMO=false

# Backend API URL. Used when VITE_USE_DEMO=false.
# For local dev with Laravel: leave empty (uses vite proxy to localhost:8000)
# For production (same host): https://arooth.com/api/v1 — see .env.production.example
VITE_API_URL=

# Production site URL (SEO meta)
# VITE_SITE_URL=https://www.arooth.com

# Optional: shown on Dashboard > Help as the support mailto address
# VITE_SUPPORT_EMAIL=support@yourdomain.com

# Wallet recharge/withdraw: use schema-driven forms from /finance/wallet/*-schema (auto-enabled when API returns methods)
# VITE_USE_DYNAMIC_WALLET=true

# Maps — full checklist: frontend/docs/MAPS_SETUP.md
# Dev: OSM without token. Mapbox auto-enables when VITE_MANFITH_MAP_PUBLIC_TOKEN or backend MAPBOX_PUBLIC_ACCESS_TOKEN is set (overrides VITE_MAP_PROVIDER for engine selection).
# Google Cloud: enable Maps JavaScript API, Places API, Geocoding API; restrict key by HTTP referrer + API.
# Budgets/alerts and daily quotas are strongly recommended before production.
#
# VITE_MAP_ENGINE=           # unset = legacy (Google/OSM Leaflet); manfith = Mapbox GL (Manfith-style)
# VITE_MAP_PROVIDER=        # unset = auto (Google if key set, else OSM); google | osm — ignored when manfith+token set
# VITE_GOOGLE_MAPS_API_KEY=
# VITE_MAPBOX_ACCESS_TOKEN= # alias for Manfith public token if not using VITE_MANFITH_MAP_PUBLIC_TOKEN
# VITE_MAP_DEFAULT_LAT=24.7136
# VITE_MAP_DEFAULT_LNG=46.6753
#
# Manfith (public tokens only; never commit secrets)
# Clone reference repo: npm run setup:manfith  (see frontend/vendor/README.md)
# MANFITH_REPO_URL=git@github.com:bbccbbcc2010-alt/manfith.git
# VITE_MANFITH_MAP_API_BASE=
# VITE_MANFITH_MAP_PUBLIC_TOKEN=
# VITE_MANFITH_MAP_STYLE_ID=
#
# /maps-test (dev only): set token above then visit http://localhost:5173/maps-test