# Demo mode for standalone frontend (no backend required)
VITE_USE_DEMO=false
# Leave empty so the app uses /api/v1 on the Vite dev origin and vite.config.js proxies to Laravel.
# A full URL like http://localhost:8000/api/v1 bypasses the proxy and often triggers CORS "Network Error" in the browser.
VITE_API_URL=

# Maps: do not set VITE_MAP_PROVIDER=osm when VITE_MAP_ENGINE=manfith + token in .env — that forces Leaflet on pickers. OSM is used automatically when no Mapbox token.
VITE_MAP_DEFAULT_LAT=24.7136
VITE_MAP_DEFAULT_LNG=46.6753
