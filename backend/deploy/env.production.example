APP_NAME=Arooth
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.arooth.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arooth
DB_USERNAME=arooth
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.arooth.com

FRONTEND_URL=https://www.arooth.com
SANCTUM_STATEFUL_DOMAINS=arooth.com,www.arooth.com

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

SEO_SITE_URL=https://www.arooth.com
CONTACT_SUPPORT_EMAIL=contact@arooth.com
CONTACT_NOTIFY_EMAILS=contact@arooth.com

# First super_admin — email must end with @arooth.com
ADMIN_EMAIL=admin@arooth.com
ADMIN_PASSWORD=CHANGE_ME_STRONG
ADMIN_NAME="Platform Admin"

MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=contact@arooth.com
MAIL_FROM_NAME="${APP_NAME}"
# If SMTP is not ready yet, use log driver so registration never fails (OTP appears in storage/logs):
# MAIL_MAILER=log

LISTINGS_AUTO_PUBLISH_ON_CREATE=true
