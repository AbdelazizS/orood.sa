APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production (see backend/deploy/env.production.example)
# FRONTEND_URL=https://arooth.com
# SESSION_DOMAIN=.arooth.com
# SANCTUM_STATEFUL_DOMAINS=arooth.com,www.arooth.com
# SEO_SITE_URL=https://www.arooth.com
# ADMIN_EMAIL=admin@arooth.com
# ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
PASSWORD_POLICY_MODE=simple
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Production MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=arooth
# DB_USERNAME=arooth
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# When true, new seller listings are published immediately (public feed + detail).
LISTINGS_AUTO_PUBLISH_ON_CREATE=true
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Public contact page (/contact) — used by ContactPageSeeder; never falls back to example.com
CONTACT_SUPPORT_EMAIL=
CONTACT_NOTIFY_EMAILS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Comma-separated category slugs treated as real estate (see config/listings.php). Default: real-estate
# REAL_ESTATE_CATEGORY_SLUGS=real-estate
# Enable schema-driven /add forms globally (per-category: categories.dynamic_schema_enabled)
# LISTINGS_DYNAMIC_SCHEMA_ENABLED=true

VITE_APP_NAME="${APP_NAME}"

# Maps (public Mapbox token — exposed via GET /api/v1/maps/config)
# MAP_ENGINE=manfith
# MAPBOX_PUBLIC_ACCESS_TOKEN=pk.eyJ...
# MAPBOX_STYLE_ID=mapbox/streets-v12
# MAP_DEFAULT_LAT=24.7136
# MAP_DEFAULT_LNG=46.6753

# Nominatim proxy (OSM geocode search/reverse — server-side only)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_USER_AGENT=Arooth/1.0 (+https://yourdomain.com)
# GEOCODE_CACHE_TTL=3600
# NOMINATIM_VIEWBOX=34.5,16.0,55.7,32.2
